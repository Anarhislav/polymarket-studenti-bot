# Copy to .env (never committed) and fill in.
# Telegram: create a bot with @BotFather, send it /start, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates ("chat":{"id": ...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live trading: read only with --live and "trading_mode": "live" in config.json.
# Accounts created on polymarket.com after 4 May 2026 are Deposit Wallets (wallet type 3),
# including accounts that log in with MetaMask.
# SIGNER_PRIVATE_KEY: private key of the signer that owns the wallet (or of an authorized
#   Session Key, which can trade but cannot withdraw).
# POLYMARKET_WALLET_ADDRESS: the account wallet address from the polymarket.com profile menu.
SIGNER_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Dashboard on the web (Docker only): HTTPS with a username and password through Caddy.
# Set the password first with: bash deploy/set-dashboard-password.sh
# DASHBOARD_DOMAIN: a domain whose DNS A record points to the server, or <ip-with-dashes>.sslip.io.
#COMPOSE_PROFILES=web
#DASHBOARD_DOMAIN=
